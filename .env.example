# Base URL of the Django REST API (Backend Team).
# Leave unset / commented out to run the frontend in MOCK MODE with local
# in-memory data — useful before the backend exists or is reachable.
#
# Example once the backend is deployed:
# VITE_API_BASE_URL=https://portline-api.onrender.com
# VITE_API_BASE_URL=http://localhost:8000

VITE_API_BASE_URL=
