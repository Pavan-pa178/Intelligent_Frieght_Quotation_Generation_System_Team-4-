# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it is in .gitignore.

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-super-secret-key-here

# Django secret key (can be same as JWT_SECRET or separate)
SECRET_KEY=your-django-secret-key-here

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portline?retryWrites=true&w=majority

# Set to False in production
DEBUG=False
